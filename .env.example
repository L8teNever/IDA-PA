# Kopieren nach .env und ausfüllen. Die .env gehört NICHT ins Git.

# Passwort der Datenbank (beliebig, einmal festlegen)
POSTGRES_PASSWORD=bitte-aendern

# Port auf dem Host. Die Weboberfläche hat KEINE eigene Anmeldung – den Zugang davor absichern
# (z. B. Cloudflare Zero Trust, VPN) und den Port nicht offen ins Internet stellen.
IDA_PORT=8080

# Image von GitHub (Standard: ghcr.io/l8tenever/ida-pa:latest)
# IDA_IMAGE=ghcr.io/l8tenever/ida-pa:latest

# Claude-Modelle (Komma-getrennt) und Standard
# MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5,claude-fable-5-1
# DEFAULT_MODEL=claude-sonnet-5-5
# CHEAP_MODEL=claude-haiku-5-5

# Optional: Ollama für die Suche nach Bedeutung im Gedächtnis (ollama pull nomic-embed-text)
# OLLAMA_URL=http://host.docker.internal:11434
# EMBED_MODEL=nomic-embed-text

# Zeitzone für Routinen mit festen Uhrzeiten
# TIMEZONE=Europe/Berlin

# Code-Bereich: Client ID deiner GitHub OAuth App (mit aktiviertem „Device Flow“) für „Mit GitHub anmelden“.
# Kann auch unter Einstellungen → GitHub eingetragen werden.
# GITHUB_CLIENT_ID=

# Kalender (eigener Dienst mit eigenen Daten, Port 8082) – Anleitung: docs/KALENDER.md
# Geheimnis zwischen IDA und Kalender (nur im internen Docker-Netz), z. B.: openssl rand -hex 32
KALENDER_IDA_TOKEN=bitte-aendern
# KALENDER_PORT=8082                  # oder 10.7.0.1:8442, wenn nur der Tunnel/VPN drauf soll
KALENDER_PUBLIC_URL=https://kalender.kulbarts.com
# KALENDER_STATE=NW                   # Bundesland für Feiertage (BY, BW, NW, BE …)
# KALENDER_MCP_TOKEN=                 # nur für das externe MCP unter /mcp (Phase 5)

# Wiki (eigener Dienst mit Markdown-Vault + SQLite, Port 8083) – Anleitung: docs/WIKI.md
# Geheimnis zwischen IDA und Wiki (nur im internen Docker-Netz), z. B.: openssl rand -hex 32
WIKI_IDA_TOKEN=bitte-aendern
# WIKI_PORT=8083
WIKI_PUBLIC_URL=https://wiki.kulbarts.com
# WIKI_MCP_TOKEN=                     # Master-Token für externes MCP unter /mcp (zusätzlich benannte Tokens in der Wiki-App)

# Code (eigene App für den Code-Bereich, Port 8084; die Arbeit macht weiter IDA) – Anleitung: docs/CODE.md
# leer = der Code-Bereich bleibt in IDA unter /code
CODE_PUBLIC_URL=https://code.kulbarts.com
# CODE_PORT=8084
# IDA_PUBLIC_URL=https://ida.kulbarts.com   # Link zurück zu IDA in den Code-Einstellungen
