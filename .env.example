# Kopieren nach .env und ausfüllen. Die .env gehört NICHT ins Git.

# Passwort der Datenbank (beliebig, einmal festlegen)
POSTGRES_PASSWORD=bitte-aendern

# Port auf dem Host. Die Weboberfläche hat KEINE eigene Anmeldung – den Zugang davor absichern
# (z. B. Cloudflare Zero Trust, VPN) und den Port nicht offen ins Internet stellen.
IDA_PORT=8080

# Image von GitHub (Standard: ghcr.io/l8tenever/ida-pa:latest)
# IDA_IMAGE=ghcr.io/l8tenever/ida-pa:latest

# Claude-Modelle (Komma-getrennt) und Standard
# MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5,claude-fable-5-1
# DEFAULT_MODEL=claude-sonnet-5-5
# CHEAP_MODEL=claude-haiku-5-5

# Optional: Ollama für die Suche nach Bedeutung im Gedächtnis (ollama pull nomic-embed-text)
# OLLAMA_URL=http://host.docker.internal:11434
# EMBED_MODEL=nomic-embed-text

# Zeitzone für Routinen mit festen Uhrzeiten
# TIMEZONE=Europe/Berlin
