# Kopieren nach .env und ausfüllen. Die .env gehört NICHT ins Git.

# Passwort der Datenbank (beliebig, einmal festlegen)
POSTGRES_PASSWORD=bitte-aendern

# Port auf dem Host. Die Weboberfläche hat KEINE eigene Anmeldung – den Zugang davor absichern
# (z. B. Cloudflare Zero Trust, VPN) und den Port nicht offen ins Internet stellen.
IDA_PORT=8080

# Image von GitHub (Standard: ghcr.io/l8tenever/ida-pa:latest)
# IDA_IMAGE=ghcr.io/l8tenever/ida-pa:latest

# Claude-Modelle (Komma-getrennt) und Standard
# MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5,claude-fable-5-1
# DEFAULT_MODEL=claude-sonnet-5-5
# CHEAP_MODEL=claude-haiku-5-5

# Ollama läuft im Stack mit (Dienst "ollama", lädt nomic-embed-text automatisch): Gedächtnis-Suche + „Auto“-Modellwahl.
# Anderes Embedding-Modell:            OLLAMA_EMBED_MODEL=nomic-embed-text
# Stattdessen Ollama auf dem Host:     OLLAMA_URL=http://host.docker.internal:11434
# EMBED_MODEL=nomic-embed-text

# Zeitzone für Routinen mit festen Uhrzeiten
# TIMEZONE=Europe/Berlin

# Code-Bereich: Client ID deiner GitHub OAuth App (mit aktiviertem „Device Flow“) für „Mit GitHub anmelden“.
# Kann auch unter Einstellungen → GitHub eingetragen werden.
# GITHUB_CLIENT_ID=

# Kalender (eigener Dienst mit eigenen Daten, Port 8082) – Anleitung: docs/KALENDER.md
# Geheimnis zwischen IDA und Kalender (nur im internen Docker-Netz), z. B.: openssl rand -hex 32
KALENDER_IDA_TOKEN=bitte-aendern
# KALENDER_PORT=8082                  # oder 10.7.0.1:8442, wenn nur der Tunnel/VPN drauf soll
KALENDER_PUBLIC_URL=https://kalender.kulbarts.com
# KALENDER_STATE=NW                   # Bundesland für Feiertage (BY, BW, NW, BE …)
# KALENDER_MCP_TOKEN=                 # nur für das externe MCP unter /mcp (Phase 5)

# Wiki (eigener Dienst mit Markdown-Vault + SQLite, Port 8083) – Anleitung: docs/WIKI.md
# Geheimnis zwischen IDA und Wiki (nur im internen Docker-Netz), z. B.: openssl rand -hex 32
WIKI_IDA_TOKEN=bitte-aendern
# WIKI_PORT=8083
WIKI_PUBLIC_URL=https://wiki.kulbarts.com
# WIKI_MCP_TOKEN=                     # Master-Token für externes MCP unter /mcp (zusätzlich benannte Tokens in der Wiki-App)

# Code (eigene App für den Code-Bereich, Port 8084; die Arbeit macht weiter IDA) – Anleitung: docs/CODE.md
# leer = der Code-Bereich bleibt in IDA unter /code
CODE_PUBLIC_URL=https://idacode.kulbarts.com
# CODE_PORT=8084
# IDA_PUBLIC_URL=https://ida.kulbarts.com   # Link zurück zu IDA in den Code-Einstellungen

# Dashboard (eigene App für den Server: Docker-Stacks, Leistung, Speicher; Port 8085) – Anleitung: docs/DASHBOARD.md
# Hat den Docker-Socket = volle Kontrolle über den Server. Nur hinter Cloudflare Access/VPN freigeben!
DASHBOARD_PUBLIC_URL=https://dashboard.kulbarts.com
# DASHBOARD_PORT=8085                 # oder 127.0.0.1:8085, wenn nur der Tunnel drauf soll
# STACKS_ROOT=/opt                    # Ordner mit allen Stack-Ordnern; wird im Container unter demselben Pfad eingebunden
# DASHBOARD_STACKS_DIRS=/opt/stacks   # hier wird nach Stacks gesucht, die gerade ganz aus sind (Komma-getrennt)
# DASHBOARD_NET_IFACES=enp0s31f6      # Netzwerkkarte(n) fürs Internet; leer = alle echten Karten

# IDA Server (dieselbe App im Modus „server“: Websites, Veröffentlichen, Stacks, Dateien) – Anleitung: docs/SERVER.md
SERVER_PUBLIC_URL=https://server.kulbarts.com
# SERVER_PORT=8088                     # Tunnel: server.kulbarts.com → http://<server>:8088 (+ Cloudflare Access!)
# SITES_DIR=/opt/ida-sites             # Dateien der Websites
# SITES_PORT=10.7.0.1:8087             # nginx der Websites; an die IP binden, über die cloudflared den Server erreicht
# SITES_UPSTREAM=                      # nur nötig, wenn die Automatik nicht passt, z. B. http://10.7.0.1:8087
# TUNNEL_HOST_IP=                      # IP des Servers für Tunnel-Ziele; leer = aus den vorhandenen Tunnel-Regeln

# Cloudflare: ein API-Token für den Cloudflare-MCP (Dienst „cloudflare“) UND das Dashboard (Zero-Trust-Schutz der URLs, Tunnel-Routen).
# Rechte (Account- oder User-Token): Zone DNS/Zone Settings/Cache Purge/Firewall Services, Account Cloudflare Tunnel,
# Access: Apps and Policies – das Dashboard liest nur. Anleitung: docs/DASHBOARD.md
# COMPOSE_PROFILES=cloudflare          # startet den Cloudflare-MCP mit (mehrere Profile mit Komma, z. B. cloudflare,autoupdate)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MCP_TOKEN=                # schützt den MCP-Endpunkt, mind. 16 Zeichen: openssl rand -hex 32
# CLOUDFLARE_MCP_PORT=10.7.0.1:8030    # Standard 127.0.0.1:8030
# CLOUDFLARE_ACCOUNT_ID=               # leer = erstes Konto des Tokens
# DOCKER_CONFIG_DIR=/root/.docker     # Login für private Images beim Aktualisieren

# Stella – Live-Sprache (Live-Knopf in der App + Telefon), eigener Container „voice“, Port 8086 – Anleitung: docs/STELLA.md
# Geheimnis zwischen IDA und voice (signiert auch die Browser-Tickets), z. B.: openssl rand -hex 32. Leer = Stella aus.
VOICE_SECRET=
# Sandbox der Code-Threads: langes Zufallswort, leer = aus (openssl rand -hex 32)
SANDBOX_SECRET=
# Öffentliche Adresse des voice-Containers (Cloudflare-Tunnel, OHNE Access davor – Telnyx muss hin; geschützt durch Tickets/Signaturen)
VOICE_PUBLIC_URL=https://voice.example.com
# Optional: andere Adresse nur für Telnyx (Webhook/Media), leer = VOICE_PUBLIC_URL
VOICE_TELNYX_URL=
# VOICE_PORT=8086
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# Telefon (Telnyx Call Control). Webhook-URL in Telnyx: <VOICE_PUBLIC_URL>/telnyx/webhook
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
# Deine Nummer (+49…): nur sie wird angenommen und nur mit ihr hat Stella Zugriff auf Daten und Tools
STELLA_OWNER_NUMBER=
# VOICE_AGENT=stella                  # dieser Agent spricht (Profil, Gedächtnis, Chats)
# VOICE_CORE_TOOLS=…                  # im Gespräch direkt angebotene Tools (Rest über tool_suchen); Standard siehe backend/app/config.py
# VOICE_DENY_TOOLS=ssh_*,cloudflare_*,…  # im Gespräch nie erlaubt
